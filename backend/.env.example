# HCM Lite Backend Environment Variables
APP_NAME=HCM Lite
APP_ENV=development
TZ=Asia/Karachi

# PostgreSQL Database (local docker-compose)
DATABASE_URL=postgresql+psycopg://hcm:hcm_password@localhost:5432/hcmlite
# Supabase example:
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

POSTGRES_USER=hcm
POSTGRES_PASSWORD=hcm_password
POSTGRES_DB=hcmlite

# Security & Authentication
JWT_SECRET=YOUR_64_CHAR_HEX_SECRET_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Admin Account (used if first-run setup uses env)
ADMIN_EMAIL=admin@hcmlite.local
ADMIN_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD
COMPANY_NAME=Saylani Tech Solutions

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:3000,http://localhost:8081

# AI Configuration (Provider-agnostic: groq | gemini)
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
AI_API_KEY=
AI_MODEL_GROQ=llama-3.3-70b-versatile
AI_MODEL_GEMINI=gemini-2.0-flash
AI_TIMEOUT_SECONDS=15
AI_RATE_LIMIT_PER_HOUR=20

# Attendance & Privacy Rules
FACE_MIN_GPS_ACCURACY_M=100
STORE_FACE_PHOTOS=false
DEFAULT_TEMP_PASSWORD_LENGTH=12
